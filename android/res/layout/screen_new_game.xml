<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/select_difficulty"
        android:textColor="#FF2222"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/difficulty_penitent"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button"
            android:text="@string/difficulty_penitent"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/difficulty_cursed"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button"
            android:text="@string/difficulty_cursed"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/difficulty_damned"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button"
            android:text="@string/difficulty_damned"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <Button
        android:id="@+id/begin_journey"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_selected"
        android:text="@string/begin_journey"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/return_new_game"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/back"
        android:textColor="#AAAAAA"
        android:textSize="16sp" />

</LinearLayout>
