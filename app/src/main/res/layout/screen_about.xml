<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="35dp">

    <LinearLayout
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_panel">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about"
            android:textColor="@color/gold_parchment"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/return_about"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/return_text"
            android:textColor="@color/gold_faded"
            android:textSize="11sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <com.darkforge.bloodsouls.views.SkullView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:alpha="0.6" />

        <TextView
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/about_description"
            android:textColor="@color/gold_faded"
            android:textSize="12sp"
            android:textStyle="italic"
            android:gravity="center"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:layout_width="120dp"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/blood_red" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/about_footer"
            android:textColor="@color/rune_dark"
            android:textSize="9sp"
            android:gravity="center"
            android:lineSpacingExtra="5dp" />

    </LinearLayout>

</LinearLayout>
