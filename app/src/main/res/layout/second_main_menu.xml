<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="35dp">

    <!-- LEFT PANEL -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.42"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_panel">

        <com.darkforge.bloodsouls.views.SkullView
            android:layout_width="56dp"
            android:layout_height="56dp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="12dp" />

        <TextView
            android:id="@+id/game_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_title"
            android:textColor="@color/blood_crimson"
            android:textSize="34sp"
            android:gravity="center"
            android:lineSpacingExtra="0dp"
            android:fontFamily="serif"
            android:shadowColor="@color/blood_red"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="18" />

        <Space
            android:layout_width="1dp"
            android:layout_height="10dp" />

        <TextView
            android:layout_width="140dp"
            android:layout_height="1dp"
            android:background="@color/blood_red" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/death_quote"
            android:textColor="@color/gold_faded"
            android:textSize="11sp"
            android:textStyle="italic"
            android:gravity="center" />

        <Space
            android:layout_width="1dp"
            android:layout_height="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version"
            android:textColor="@color/rune_dark"
            android:textSize="8sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- RIGHT MENU -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.58"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <TextView
            android:id="@+id/menu_new_game"
            style="@style/MenuButton"
            android:text="@string/new_game" />

        <TextView
            android:id="@+id/menu_continue"
            style="@style/MenuButton"
            android:text="@string/continue_game" />

        <TextView
            android:id="@+id/menu_options"
            style="@style/MenuButton"
            android:text="@string/options" />

        <TextView
            android:id="@+id/menu_about"
            style="@style/MenuButton"
            android:text="@string/about" />

        <TextView
            android:id="@+id/menu_exit"
            style="@style/MenuButton"
            android:text="@string/exit" />

    </LinearLayout>

</LinearLayout>
