<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="35dp">

    <LinearLayout
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_panel">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/options"
            android:textColor="@color/gold_parchment"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/return_options"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/return_text"
            android:textColor="@color/gold_faded"
            android:textSize="11sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="30dp">

            <LinearLayout
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/OptionLabel"
                    android:text="@string/music" />

                <Switch
                    android:id="@+id/music_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/OptionLabel"
                    android:text="@string/sound_fx" />

                <Switch
                    android:id="@+id/sfx_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />

            </LinearLayout>

            <TextView
                style="@style/OptionTitle"
                android:text="@string/blood_splatter" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/blood_low"
                    style="@style/SmallBloodButton"
                    android:text="@string/low" />

                <Button
                    android:id="@+id/blood_medium"
                    style="@style/SmallBloodButton"
                    android:text="@string/medium" />

                <Button
                    android:id="@+id/blood_high"
                    style="@style/SmallBloodButton"
                    android:text="@string/high" />

            </LinearLayout>

            <TextView
                style="@style/OptionTitle"
                android:text="@string/language" />

            <LinearLayout
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/language_english"
                    style="@style/LanguageButton"
                    android:text="@string/english" />

                <TextView
                    android:id="@+id/language_afrikaans"
                    style="@style/LanguageButton"
                    android:text="@string/afrikaans" />

                <TextView
                    android:id="@+id/language_xhosa"
                    style="@style/LanguageButton"
                    android:text="@string/xhosa" />

                <TextView
                    android:id="@+id/language_tswana"
                    style="@style/LanguageButton"
                    android:text="@string/tswana" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
