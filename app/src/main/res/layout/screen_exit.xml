<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="35dp">

    <LinearLayout
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_panel">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exit_game"
            android:textColor="@color/gold_parchment"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/return_exit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/return_text"
            android:textColor="@color/gold_faded"
            android:textSize="11sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:text="@string/exit_message"
            android:textColor="@color/gold_faded"
            android:textSize="13sp"
            android:textStyle="italic"
            android:gravity="center"
            android:lineSpacingExtra="6dp" />

        <Button
            android:id="@+id/stay_button"
            style="@style/BloodPrimaryButton"
            android:layout_width="220dp"
            android:layout_marginTop="16dp"
            android:text="@string/stay_and_suffer" />

        <Button
            android:id="@+id/abandon_button"
            style="@style/BloodButton"
            android:layout_width="220dp"
            android:layout_marginTop="8dp"
            android:text="@string/abandon_hope" />

    </LinearLayout>

</LinearLayout>
