<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="35dp">

    <LinearLayout
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:background="@drawable/bg_panel">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_game"
            android:textColor="@color/gold_parchment"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/return_new_game"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/return_text"
            android:textColor="@color/gold_faded"
            android:textSize="11sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/choose_burden"
            android:textColor="@color/gold_faded"
            android:textSize="12sp"
            android:textStyle="italic" />

        <Button
            android:id="@+id/difficulty_penitent"
            style="@style/BloodButton"
            android:text="@string/penitent" />

        <Button
            android:id="@+id/difficulty_cursed"
            style="@style/BloodButton"
            android:text="@string/cursed" />

        <Button
            android:id="@+id/difficulty_damned"
            style="@style/BloodButton"
            android:text="@string/damned" />

        <Space
            android:layout_width="1dp"
            android:layout_height="8dp" />

        <Button
            android:id="@+id/begin_journey"
            style="@style/BloodPrimaryButton"
            android:text="@string/begin_journey" />

    </LinearLayout>

</LinearLayout>
